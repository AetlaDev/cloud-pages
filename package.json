{
  "name": "aetla",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"wrangler dev -c cloudflare/wrangler.jsonc --port 8787\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev -c cloudflare/wrangler.jsonc --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc -p cloudflare/tsconfig.json",
    "db:init": "wrangler d1 execute aetla-users -c cloudflare/wrangler.jsonc --local --file=cloudflare/schema.sql",
    "deploy": "npm run build && wrangler deploy -c cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@m3e/web": "^2.10.2",
    "lenis": "1.1.18",
    "lottie-web": "^5.13.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.169.0",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.0",
    "vite": "^6.2.0",
    "wrangler": "^4.147.0"
  }
}
